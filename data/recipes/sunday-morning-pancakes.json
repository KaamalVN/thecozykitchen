      "items": [
        { "text": "In a large bowl, sift together the flour, baking powder, salt, and sugar.", "timer": null },
        { "text": "Make a well in the center and pour in the milk, egg, and melted butter; mix until smooth.", "timer": null },
        { "text": "Heat a lightly oiled griddle or frying pan over medium-high heat. Pour or scoop the batter onto the griddle, using approximately 1/4 cup for each pancake.", "timer": null },
        { "text": "Brown on both sides (about 2-3 minutes per side) and serve hot with maple syrup.", "timer": 3 }
      ]
